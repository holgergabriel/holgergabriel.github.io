---
import "../styles/global.css";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Der singende Mensch</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <main>

      <!-- HERO -->

      <section class="hero">

        <h1>
          Der singende
          <br />
          Mensch
        </h1>



        <p class="hero-text">
          Singen betrifft
          <br />
          nicht nur die Stimme selbst,
          <br /><br />

          sondern bewegt
          <br />
          den ganzen Menschen.
        </p>

      </section>


      <!-- PHILOSOPHY -->

      <section class="philosophy">

        <div class="text-block">

          <p>
            Die Stimme lässt
            <br />
            Lebensgeschichte erklingen:
            <br /><br />

            <em>Kraftvoll, empfindsam, einfach.</em>
          </p>

        </div>

      </section>


      <!-- OPENING -->

      <section class="opening">

        <div class="opening-text">

          <p>
            Als Menschen
            <br />
            singen wir nicht nur
            <br />
            mit unserer Stimme.
          </p>

          <p class="terms">

            Wir singen
            <br /><br />

            mit unserer Wahrnehmung,
            <br />
            unserer Spannung,
            <br />
            unserer Geschichte,
            <br />
            unserem Körper und Leib,
            <br />
            unserer Präsenz.

          </p>

        </div>

      </section>


      <!-- TRANSITION -->

      <section class="transition">

        <p>
          Wahrnehmung verändert,
          <br />
          wie wir hören,
          <br />
          wie wir singen,
          <br />
          wie wir uns selbst begegnen.
        </p>

      </section>


      <!-- RESONANCE ROOM -->

      <section class="resonance-room">

        <div class="resonance-text">

          <p>
            Wie verändert Singen
            <br />
            die Wahrnehmung
            <br />
            des eigenen Menschseins?
          </p>

          <a class="room-link" href="/resonanzraum">
            Resonanzraum des Singens
          </a>


        </div>

      </section>


      <!-- SOFT TRANSITION -->

      <section class="transition transition-soft">

        <p>
          Manche Zugänge
          <br />
          zur Stimme
          <br />
          entstehen langsam.
        </p>

      </section>


      <!-- EXPERIENCE ROOM -->

      <section class="experience-room">

        <div class="experience-text">

          <p>
            Der Zugang zur Stimme
            <br />
            entsteht nicht nur
            <br />
            aus Technik oder Wissen.
          </p>

          <p>
            Er entsteht
            <br />
            aus Erfahrung,
            <br />
            Beobachtung,
            <br />
            Veränderung,
            <br />
            Krankheit,
            <br />
            Entwicklung,
            <br />
            Wahrnehmung
            <br />
            und gelebtem Leben.
          </p>

          <a class="room-link" href="/erfahrungsraum">
            Erfahrungsraum
          </a>

        </div>

      </section>


      <!-- PRACTICE ROOM -->

      <section class="practice-room">

        <div class="practice-text">

          <p>
            Manchmal beginnt Veränderung,
            <br />
            wenn Spannung
            <br />
            wahrgenommen werden kann.
          </p>

          <p>
            Wenn Atem,
            <br />
            Klang,
            <br />
            Haltung,
            <br />
            Resonanz
            <br />
            und Aufmerksamkeit
            <br />
            sich verändern,
            <br />
            verändert sich oft
            <br />
            der ganze Mensch.
          </p>

          <div class="room-link">
            Praxisraum
          </div>

        </div>

      </section>


      <!-- SPIRITUAL ROOM -->

      <section class="spiritual-room">

        <div class="spiritual-text">

          <p>
            Manche Räume
            <br />
            verändern das Hören.
          </p>

          <p>
            Wenn Stimme,
            <br />
            Stille,
            <br />
            Resonanz
            <br />
            und Raum
            <br />
            einander begegnen,
            <br /><br />

            entsteht
            <br />
            eine andere Form
            <br />
            von Präsenz.
          </p>

          <div class="room-link">
            Geistliche Konzertformen
          </div>

        </div>

      </section>


      <!-- END SPACE -->

      <section class="end-space"></section>

    </main>

  </body>
</html>