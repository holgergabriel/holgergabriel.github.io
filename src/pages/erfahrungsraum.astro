---
import "../styles/global.css";
import "../styles/erfahrungsraum.css";
import "../styles/thresholds.css";
import "../styles/rhythms.css";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Erfahrungsraum – Der singende Mensch</title>

  </head>

  <body>

    <main class="experience-space">

      <a href="/" class="back-link">
        Zur Startseite
      </a>


      <!-- HERO -->

      <section class="experience-hero">

        <h1>
          Erfahrungsraum
        </h1>

        <p class="hero-subline">
          Nicht jede Stimme
          <br />
          entsteht unter Sicherheit.
        </p>

      </section>


      <!-- OPENING -->

      <section class="opening-space space-open">

        <div class="opening-text type-fragment">

          <p>
            Manche Stimmen
            <br />
            werden vorsichtig.
          </p>

          <p>
            Manche laut.
          </p>

          <p>
            Manche verschwinden fast.
          </p>

          <p>
            Und manche beginnen erst spät.
          </p>

        </div>

      </section>


      <!-- BIOGRAPHY -->

      <section class="biography-space  space-dense">

        <div class="biography-text type-reflection">

          <p>
            Menschen singen
            <br />
            nicht außerhalb ihres Lebens.
          </p>

          <p>
            Sie singen
            <br />
            mit ihrer Geschichte.
            <br />
            Mit ihrem Körper.
            <br />
            Mit ihrer Angst.
            <br />
            Mit ihrer Hoffnung.
            <br />
            Mit ihrem Alter.
            <br />
            Mit ihren Beziehungen.
            <br />
            Mit ihrer Erfahrung.
          </p>

        </div>

      </section>


      <!-- PERSPECTIVES -->

      <section class="perspective-space space-dense">

        <div class="perspective-block">

          <p class="perspective-label">
            Ich / Wir
          </p>

          <p>
            Ich singe.
          </p>

          <p>
            Ich höre mich.
          </p>

          <p>
            Ich spüre
            <br />
            Spannung,
            <br />
            Atem,
            <br />
            Unsicherheit,
            <br />
            Mut,
            <br />
            Klang,
            <br />
            Freude.
          </p>

        </div>


        <div class="perspective-block">

          <p class="perspective-label">
            Du / Sie
          </p>

          <p>
            Du hörst.
          </p>

          <p>
            Du fühlst.
          </p>

          <p>
            Du antwortest.
          </p>

          <p>
            Stimmen entstehen
            <br />
            nicht ohne Gegenüber.
          </p>

        </div>


        <div class="perspective-block">

          <p class="perspective-label">
            Er / Sie / Es
          </p>

          <p>
            Stimme entsteht <br />
            nicht isoliert.
            <br />
            <br />
            Sondern <br />
            im Zusammenhang von:
          </p>

          <p>
            Wahrnehmung.
            <br />
            Organismus.
            <br />
            Erfahrung.
            <br />
            Spannung.
            <br />
            Beziehung.
            <br />
            Gemeinschaft.
            <br />
            Resonanz.
          </p>

        </div>

      </section>


      <!-- GESTALTKREIS -->

      <section class="modal-space">

        <div class="modal-introduction">

          <p>
            Menschliche Erfahrung
            <br />
            bewegt sich oft
            <br />
            zwischen:
          </p>

        </div>

        <div class="modal-word">dürfen</div>

        <div class="modal-word">wollen</div>

        <div class="modal-word">können</div>

        <div class="modal-word">sollen</div>

        <div class="modal-word">müssen</div>

      </section>


      <!-- COMMUNITY -->

      <section class="community-space">

        <div class="community-text">

          <p>
            Manche Menschen
            <br />
            finden ihre Stimme allein.
          </p>

          <p>
            Andere erst
            <br />
            im gemeinsamen Klang.
          </p>

          <p>
            Gemeinsames Singen
            <br />
            verändert oft mehr als nur Klang.
          </p>

          <p>
            Es bietet Zugang zu:
            <br />
            Atmung.
            <br />
            Wahrnehmung.
            <br />
            Mut.
            <br />
            Nähe.
            <br />
            Zugehörigkeit.
          </p>

        </div>

      </section>


      <!-- TRANSFORMATION -->

      <section class="transformation-space">

        <div class="transformation-text">

          <p>
            Singen bedeutet nicht,
            <br />
            keine Grenzen zu haben.
          </p>

          <p>
            Sondern:
          </p>

          <p>
            mit den Bedingungen 
            <br />
            und dem Wandel
            <br />
            des eigenen Lebens
            <br />
            in Beziehung zu bleiben.
            <br />
            <br />
            Als gesunder und kranker Mensch.
          </p>

        </div>

      </section>


      <!-- OPENING -->

      <section class="final-space">

        <div class="final-text">

          <p>
            Der Mensch bleibt
            <br />
            lebenslang
            <br />
            im Werden.
          </p>

        </div>

      </section>

      <section class="threshold-space">

        <nav class="threshold-navigation">

          <a href="/resonanzraum">
            Resonanzraum des Singens
          </a>

          <a href="/praxisraum">
            Praxisraum
          </a>

          <a href="/geistliche-konzertformen">
            Geistliche Konzertformen
          </a>

        </nav>

      </section>

    </main>

  </body>
</html>