---
import "../styles/global.css";
import "../styles/erfahrungsraum.css";
import "../styles/thresholds.css";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Erfahrungsraum – Der singende Mensch</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <main class="experience-space">

      <a href="/" class="back-link">
        Zur Startseite
      </a>


      <!-- HERO -->

      <section class="experience-hero">

        <h1>
          Erfahrungsraum
        </h1>

        <p class="hero-subline">
          Nicht jede Stimme
          <br />
          entsteht unter Sicherheit.
        </p>

      </section>


      <!-- OPENING -->

      <section class="opening-space">

        <div class="opening-text">

          <p>
            Manche Stimmen
            <br />
            werden vorsichtig.
          </p>

          <p>
            Manche laut.
          </p>

          <p>
            Manche verschwinden fast.
          </p>

          <p>
            Und manche beginnen erst spät.
          </p>

        </div>

      </section>


      <!-- BIOGRAPHY -->

      <section class="biography-space">

        <div class="biography-text">

          <p>
            Menschen singen
            <br />
            nicht außerhalb ihres Lebens.
          </p>

          <p>
            Sie singen
            <br />
            mit ihrer Geschichte,
            <br />
            mit ihrem Körper,
            <br />
            mit ihrer Angst,
            <br />
            mit ihrer Hoffnung,
            <br />
            mit ihrem Alter,
            <br />
            mit ihren Beziehungen,
            <br />
            mit ihrer Erfahrung.
          </p>

        </div>

      </section>


      <!-- PERSPECTIVES -->

      <section class="perspective-space">

        <div class="perspective-block">

          <p class="perspective-label">
            Ich / Wir
          </p>

          <p>
            Ich singe.
          </p>

          <p>
            Ich höre mich.
          </p>

          <p>
            Ich spüre
            <br />
            Spannung,
            <br />
            Atem,
            <br />
            Unsicherheit,
            <br />
            Mut,
            <br />
            Klang,
            <br />
            Freude.
          </p>

        </div>


        <div class="perspective-block">

          <p class="perspective-label">
            Du / Sie
          </p>

          <p>
            Du hörst.
          </p>

          <p>
            Du antwortest.
          </p>

          <p>
            Stimmen entstehen
            <br />
            nicht ohne Gegenüber.
          </p>

        </div>


        <div class="perspective-block">

          <p class="perspective-label">
            Er / Sie / Es
          </p>

          <p>
            Stimme entsteht
            <br />
            im Zusammenhang von:
          </p>

          <p>
            Wahrnehmung,
            <br />
            Beziehung,
            <br />
            Organismus,
            <br />
            Erfahrung,
            <br />
            Spannung,
            <br />
            Resonanz.
          </p>

        </div>

      </section>


      <!-- GESTALTKREIS -->

      <section class="modal-space">

        <div class="modal-word">dürfen</div>

        <div class="modal-word">wollen</div>

        <div class="modal-word">können</div>

        <div class="modal-word">sollen</div>

        <div class="modal-word">müssen</div>

      </section>


      <!-- COMMUNITY -->

      <section class="community-space">

        <div class="community-text">

          <p>
            Manche Menschen
            <br />
            finden ihre Stimme allein.
          </p>

          <p>
            Andere erst
            <br />
            im gemeinsamen Klang.
          </p>

          <p>
            Gemeinsames Singen
            <br />
            verändert nicht nur Klang.
          </p>

          <p>
            Sondern:
            <br />
            Atmung,
            <br />
            Wahrnehmung,
            <br />
            Mut,
            <br />
            Nähe
            <br />
            und Zugehörigkeit.
          </p>

        </div>

      </section>


      <!-- TRANSFORMATION -->

      <section class="transformation-space">

        <div class="transformation-text">

          <p>
            Gesundheit bedeutet nicht,
            <br />
            keine Grenzen zu haben.
          </p>

          <p>
            Sondern:
          </p>

          <p>
            mit den Bedingungen
            <br />
            des eigenen Lebens
            <br />
            in Beziehung bleiben zu können.
          </p>

        </div>

      </section>


      <!-- OPENING -->

      <section class="final-space">

        <div class="final-text">

          <p>
            Der Mensch bleibt
            <br />
            lebenslang
            <br />
            im Werden.
          </p>

        </div>

      </section>

      <section class="threshold-space">

        <nav class="threshold-navigation">

          <a href="/resonanzraum">
            Resonanzraum des Singens
          </a>

          <a href="/praxisraum">
            Praxisraum
          </a>

        </nav>

      </section>

    </main>

  </body>
</html>