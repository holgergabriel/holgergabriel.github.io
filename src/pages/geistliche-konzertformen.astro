---
import "../styles/global.css";
import "../styles/geistliche-konzertformen.css";
import "../styles/thresholds.css";
import "../styles/rhythms.css";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>
      Geistliche Konzertformen – Der singende Mensch
    </title>

  </head>

  <body>

    <main class="spiritual-space">

      <a href="/" class="back-link">
        Zur Startseite
      </a>


      <!-- HERO -->

      <section class="spiritual-hero">

        <h1>
          Geistliche
          <br />
          Konzertformen
        </h1>

        <p class="hero-subline">
          Manche Formen des Singens
          <br />
          verändern,
          <br />
          wie Menschen gegenwärtig werden.
        </p>

      </section>


      <!-- THRESHOLD -->

      <section class="spiritual-threshold space-open">

        <div class="threshold-text type-resonance-large">

          <p>
            Manche Räume
            <br />
            verändern,
            <br />
            wie Menschen hören.
          </p>

        </div>

      </section>


      <!-- SILENCE -->

      <section class="spiritual-silence space-floating">

        <div class="silence-text type-floating">

          <p>
            Nicht jeder Klang
            <br />
            endet,
            <br />
            wenn er verstummt.
          </p>

        </div>

      </section>


      <!-- PRESENCE -->

      <section class="spiritual-presence space-open">

        <div class="presence-text">

          <p>
            Manche Stimmen
            <br />
            wollen nicht beeindrucken.
          </p>

          <p>
            Sondern:
            <br />
            gegenwärtig werden.
          </p>

        </div>

      </section>


      <!-- RESONANCE -->

      <section class="spiritual-resonance space-dense">

        <div class="resonance-text">

          <p>
            Zwischen Klang
            <br />
            und Stille
            <br />
            entstehen manchmal
            <br />
            andere Formen
            <br />
            des Hörens.
          </p>

        </div>

      </section>


      <!-- COMMUNITY -->

      <section class="spiritual-community space-open">

        <div class="community-text">

          <p>
            Nicht jede Gemeinschaft
            <br />
            entsteht durch Gespräch.
          </p>

          <p>
            Manche Formen
            <br />
            des Hörens
            <br />
            geschehen gemeinsam.
          </p>

        </div>

      </section>


      <!-- TRANSPARENCY -->

      <section class="spiritual-transparency space-floating">

        <div class="transparency-text type-fragment">

          <p>
            Manche Stimmen
            <br />
            werden nicht größer,
            <br />
            wenn sie sich behaupten.
          </p>

          <p>
            Sondern:
            <br />
            wenn sie
            <br />
            durchlässig werden.
          </p>

        </div>

      </section>


      <!-- FAITH -->

      <section class="spiritual-faith space-dense">

        <div class="faith-text">

          <p>
            Menschen leben
            <br />
            aus Voraussetzungen,
            <br />
            die nicht vollständig
            <br />
            kontrollierbar,
            <br />
            beweisbar
            <br />
            oder verfügbar sind.
          </p>

          <p>
            Manche dieser
            <br />
            unhintergehbaren
            <br />
            Hintergrundannahmen
            <br />
            werden im Gesang hörbar.
          </p>

        </div>

      </section>


      <!-- ANTHROPOLOGY -->

      <section class="spiritual-anthropology space-open">

        <div class="anthropology-text">

          <p>
            Die menschliche Stimme
            <br />
            bleibt angewiesen:
          </p>

          <p>
            Auf Raum.
            <br />
            Auf Resonanz.
            <br />
            Auf Gegenüber.
            <br />
            Auf Antwort.
          </p>

        </div>

      </section>


      <!-- OPENING -->

      <section class="spiritual-opening space-floating">

        <div class="opening-text type-resonance-large">

          <p>
            Nicht jede Resonanz
            <br />
            wird erzeugt.
          </p>

          <p>
            Manche geschieht.
          </p>

        </div>

      </section>


      <!-- RETURN -->

      <section class="threshold-space">

        <nav class="threshold-navigation">

          <a href="/resonanzraum">
            Resonanzraum
          </a>

          <a href="/praxisraum">
            Praxisraum
          </a>

          <a href="/erfahrungsraum">
            Erfahrungsraum
          </a>

        </nav>

      </section>


      <!-- END SPACE -->

      <section class="spiritual-end-space"></section>

    </main>

  </body>
</html>