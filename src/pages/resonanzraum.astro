---
import "../styles/global.css";
import "../styles/thresholds.css";
import "../styles/rhythms.css";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Resonanzraum des Singens</title>

  </head>

  <body>

    <main class="resonance-page">

      <a href="/" class="back-link">
        Zur Startseite
      </a>

      <!-- ENTRY -->

      <section class="resonance-entry space-open">

        <div class="resonance-entry-text type-resonance-large">

          <p>
            Manche Stimmen
            <br />
            verändern 
            <br />
            mehr als 
            <br />
            Klang
          </p>

        </div>

      </section>


      <!-- ENTRY TRANSITION -->

      <section class="resonance-transition">

        <p>
          Sie verändern,
          <br />
          wie ein Mensch
          <br />
          Räume wahrnimmt.
        </p>

      </section>


      <!-- FRAGMENT -->

      <section class="resonance-fragment space-open">

        <p class="type-fragment">
          Manche Veränderungen
          <br />
          entstehen langsam.
        <p>

      </section>


      <!-- EXPERIENCE -->

      <section class="resonance-experience space-dense">

        <div class="resonance-experience-text">

          <p>
            Singen entsteht
            <br />
            nicht allein im Kehlkopf.
          </p>

          <p>
            Es entsteht
            <br />
            im Zusammenhang
            <br />
            von Wahrnehmung,
            <br />
            Spannung,
            <br />
            Atmung,
            <br />
            Raum,
            <br />
            Beziehung
            <br />
            und Präsenz.
          </p>

        </div>

      </section>


      <!-- EXPERIENCE DEEPENING -->

      <section class="resonance-deepening space-dense">

        <div class="resonance-deepening-text">

          <p>
            Die Stimme trägt
            <br />
            nicht nur Klang.
          </p>

          <p>
            Sie trägt:
            <br />
            Erfahrung,
            <br />
            Spannung,
            <br />
            Verletzlichkeit,
            <br />
            Ruhe,
            <br />
            Entwicklung
            <br />
            und Lebensgeschichte.
          </p>

        </div>

      </section>


      <!-- FRAGMENT RIGHT -->

      <section class="resonance-fragment resonance-fragment-right">

        <p class="type-fragment">
          Nicht jede Stimme
          <br />
          entsteht 
          <br />
          unter Sicherheit.
        <p>

      </section>


      <!-- REFLECTION -->

      <section class="resonance-reflection space-dense">

        <div class="resonance-reflection-text">

          <p>
            Stimmen reagieren
            <br />
            auf den Zustand des Menschen.
          </p>

          <p>
            Auf Spannung.
            <br />
            Auf Sicherheit.
            <br />
            Auf Atem.
            <br />
            Auf Beziehung.
            <br />
            Auf Achtsamkeit.
            <br />
            Auf Raum.
          </p>

        </div>

      </section>


      <!-- REFLECTION TRANSITION -->

      <section class="resonance-reflection-transition">

        <p>
          Manche Veränderungen
          <br />
          entstehen nicht
          <br />
          durch mehr Kraft.
        </p>

      </section>


      <!-- PRACTICE -->

      <section class="resonance-practice">

        <div class="resonance-practice-text">

          <p>
            Manchmal verändert sich eine Stimme,
            <br />
            wenn ein Mensch
            <br />
            nicht länger
            <br />
            gegen den Klang arbeitet.
          </p>

          <p>
            Manchmal entsteht Tragfähigkeit,
            <br />
            wenn Druck verschwindet.
          </p>

          <p>
            Manchmal entsteht Resonanz,
            <br />
            wenn ein Mensch
            <br />
            beginnt zu hören.
          </p>

        </div>

      </section>


      <!-- SOFT FRAGMENT -->

      <section class="resonance-fragment resonance-fragment-soft">

        <p>
          Manche Räume
          <br />
          verändern das Hören.
        </p>

      </section>


      <!-- OPENING -->

      <section class="resonance-opening space-open">

        <div class="resonance-opening-text type-resonance-large">

          <p>
            Hören verändert,
            <br />
            wie ein Mensch singt.
          </p>

          <p>
            Singen verändert,
            wie ein Mensch hört.
          </p>

        </div>

      </section>


      <!-- THRESHOLD -->

      <section class="threshold-space">

        <nav class="threshold-navigation">

          <a href="/erfahrungsraum">
            Erfahrungsraum
          </a>

          <a href="/praxisraum">
            Praxisraum
          </a>

          <a href="/geistliche-konzertformen">
            Geistliche Konzertformen
          </a>

        </nav>

      </section>


      <!-- END SPACE -->

      <section class="resonance-end-space"></section>

    </main>

  </body>
</html>